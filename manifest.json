{
  "manifest_version": 3,
  "name": "TabLock - Browser Tab Locker",
  "version": "1.0.0",
  "key": "",
  "description": "Lock and secure your browser tabs with a password.",
  "permissions": [
    "tabs",
    "storage",
    "activeTab",
    "contextMenus",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
